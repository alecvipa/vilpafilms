<style>
    /* --- VILPA TALENTS PREMIUM STYLES --- */
    .vilpa-talents-wrapper {
        background-color: #030305;
        color: #ffffff;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        padding-bottom: 80px;
    }

    /* Declaración de la Agencia */
    .talents-statement {
        font-family: 'Georgia', serif;
        font-size: 1.8rem;
        line-height: 1.5;
        color: #d1d1db;
        max-width: 900px;
        margin: 60px auto 70px;
        text-align: center;
        font-weight: 300;
        padding: 0 20px;
    }

    /* Tarjetas de Talento (Estilo Headshot de Agencia) */
    .talent-card-premium {
        background: #0a0a0f;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        overflow: hidden;
        transition: transform 0.5s ease, box-shadow 0.5s ease, border-color 0.5s ease;
        cursor: pointer;
        margin-bottom: 30px;
    }

    .talent-card-premium:hover {
        transform: translateY(-10px);
        border-color: rgba(229, 9, 20, 0.4); /* Resplandor rojo Vilpa */
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    }

    /* Forzar proporción 4:5 para que todos los retratos midan exactamente lo mismo */
    .talent-img-wrapper {
        width: 100%;
        padding-top: 125%; 
        position: relative;
        overflow: hidden;
    }

    .talent-img-wrapper img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top; /* Enfoca en los rostros */
        transition: transform 0.7s cubic-bezier(0.25, 0.8, 0.25, 1);
        filter: grayscale(20%) contrast(110%); /* Le da un tono ligeramente más dramático */
    }

    .talent-card-premium:hover .talent-img-wrapper img {
        transform: scale(1.05);
        filter: grayscale(0%) contrast(110%);
    }

    .talent-info {
        padding: 25px 20px;
        text-align: center;
    }

    .talent-name {
        font-family: 'Georgia', serif;
        font-size: 1.4rem;
        color: #ffffff;
        margin: 0 0 5px 0;
        letter-spacing: 0.5px;
    }

    .talent-role {
        color: #E50914; /* Rojo Vilpa */
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 600;
        margin: 0;
    }

    /* Encabezados de Sección */
    .talents-section-title {
        text-align: center;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 4px;
        color: #8c8c9b;
        margin: 80px 0 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }

    .talents-section-title::before,
    .talents-section-title::after {
        content: '';
        height: 1px;
        width: 60px;
        background: rgba(255, 255, 255, 0.1);
        margin: 0 20px;
    }

    /* Proyectos (Film & TV) */
    .project-card-premium {
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        transition: transform 0.4s ease;
        margin-bottom: 20px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        cursor: pointer;
        background: #000;
    }

    .project-card-premium:hover {
        transform: translateY(-5px);
        border-color: rgba(255, 255, 255, 0.2);
    }
    
    .project-card-premium img {
        width: 100%;
        display: block;
        transition: opacity 0.3s;
    }

    .project-card-premium:hover img {
        opacity: 0.9;
    }
    
    /* Contenedor Iframes de Música */
    .music-embed-container {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        background: #0a0a0f;
        margin-bottom: 20px;
    }
</style>

