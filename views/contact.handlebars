                    <div class="input-field col s12 m6">
                        <input name="name" placeholder="Name" id="first_name" type="text" class="validate formInput" required="" aria-required="true">
                        <label for="first_name">Name</label>
                    </div>
                    <div class="input-field col s12 m6">
                        <input name="email" id="email" type="email" class="validate formInput" required="" aria-required="true">
                        <label for="email">E-mail</label>
                    </div>
                </div>
                <div class="row">
                    <div class="input-field col s12">
                        <input name="message" id="input_text" type="text" data-length="10" required="" aria-required="true" class="formInput">
                        <label for="input_text">Message</label>
                    </div>
                </div>
                <div class="row vilpa-checkbox-wrap" style="padding-left: 10px;">
                    <label>
                        <input type="checkbox" required="" aria-required="true" />
                        <span>I agree with the <a href="/privacy">privacy policy</a></span>
                    </label>
                </div>
                <div class="center-align">
                    <button class="btn waves-effect waves-light btn-vilpa-submit">Submit Inquiry
                        <i class="material-icons right" style="color: white !important;">send</i>
                    </button>
                </div>
            </form>
        </div>
    </div> 
