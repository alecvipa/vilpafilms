<style>
    /* CSS Premium para el resto de la página */
    .incioDiv {
        background-color: #141415 !important;
        color: #ffffff;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }

    /* Ajustes para los Banners de películas (ej. The Card Counter, After Yang, Ava) */
    .vilpa-poster-card {
        background: transparent;
        border: none;
        box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        border-radius: 8px;
        overflow: hidden;
        transition: transform 0.4s ease, box-shadow 0.4s ease;
        margin-bottom: 30px;
    }
    
    .vilpa-poster-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(41, 121, 255, 0.2);
    }
    
    .vilpa-poster-card img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 8px;
    }

    /* Títulos de sección */
    h5.section-title {
        color: #a0a0b0;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 3px;
        margin: 40px 0 20px 0;
    }
    
    /* El bloque central de texto (Hero / About) */
    .aboutDiv {
        padding: 60px 20px;
        text-align: center;
        background: linear-gradient(180deg, #0a0a0f 0%, #030305 100%);
    }

    .titleVilpa-hero {
        font-family: 'Georgia', serif;
        font-weight: 400;
        font-size: 2rem;
        line-height: 1.4;
        color: #e0e0e0;
        max-width: 900px;
        margin: 0 auto;
    }

    .titleVilpa-hero span.highlight {
        color: #ffffff;
        font-size: 2.2rem;
    }

    hr.premium-divider {
        border: 0;
        height: 1px;
        background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0) 100%);
        margin: 40px 0;
    }

    /* Grid asimétrica de imágenes / Galería */
    .vilpa-gallery-img {
        width: 100%;
        border-radius: 8px;
        margin-bottom: 20px;
        box-shadow: 0 8px 16px rgba(0,0,0,0.6);
        transition: transform 0.4s ease;
    }
    
    .vilpa-gallery-img:hover {
        transform: scale(1.02);
    }

    /* Contenedores de Video */
    .video-container-premium {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.6);
        border: 1px solid rgba(255,255,255,0.05);
        margin-bottom: 20px;
    }
</style>

